
# Exclude large GIS data inputs and outputs
# vector data (*.gpkg): Blocks national planning and boundary files so raw data stays on your computer.
# spatial databases (*.duckdb, *.duckdb.wal): Blocks created spatial database files so scripts generate them fresh instead.
# map outputs (*.png): Blocks exported map images so your Python scripts generate them fresh instead.
# tabular outputs (*.csv): Blocks exported data tables and summary statistics.
*.gpkg
*.duckdb
*.duckdb.wal
*.png
*.csv

# Workspace Data Folders
# Ignore all the folders containing raw data and map outputs.
data/
outputs/

# Python Temporary Files
# Ignores system temporary files created when running python scripts.
__pycache__/
*.pyc
.ipynb_checkpoints/

# OS Temporary Files
.DS_Store
Thumbs.db